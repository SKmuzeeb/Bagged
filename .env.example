# Copy this file to .env and point it at your Zippd backend.
# If left unset, zippd runs fully in local demo mode: kiranas and products
# come from src/data/, orders/favorites live in the browser's localStorage,
# and "sending" a magic link just simulates the flow. Browsing, cart,
# checkout, and order placement all work either way.

VITE_API_BASE_URL=
