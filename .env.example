# Copy this file to .env and fill in your Supabase project's values.
# If these are left unset, Tayaar runs fully in local demo mode: products come
# from src/data/sampleProducts.js and orders are stored in the browser's
# localStorage instead of Supabase. Browsing, cart, checkout, and order
# placement all work either way.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
